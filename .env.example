# Gemini (free tier - Google AI Studio)
GEMINI_API_KEY=

# Groq (free tier - chat + Whisper transcription)
GROQ_API_KEY=

# Cerebras (free tier - https://cerebras.ai)
CEREBRAS_API_KEY=

# OpenRouter (free tier - https://openrouter.ai)
OPENROUTER_API_KEY=

# Mistral (free tier - https://console.mistral.ai)
MISTRAL_API_KEY=

# Supabase (free tier)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LangFuse (free tier - agent observability)
# Note: previously named LANGFUSE_HOST — update any existing .env / CI secrets accordingly
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# PostHog (free tier - analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Demo account (optional — powers the "Explore the demo" button + `pnpm seed:demo`)
# Email that owns the seeded sample data. The account is passwordless; the demo
# button mints a one-time magic-link token server-side.
DEMO_USER_EMAIL=
# Set to 1 to show the "Explore the demo" button on the sign-in screen.
NEXT_PUBLIC_DEMO_ENABLED=

