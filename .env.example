# Gemini (free tier - Google AI Studio)
GEMINI_API_KEY=

# Groq (free tier - chat + Whisper transcription)
GROQ_API_KEY=

# Cerebras (https://cloud.cerebras.ai) — free access may now be trial-credit only; optional fallback
CEREBRAS_API_KEY=

# OpenRouter (free tier - https://openrouter.ai)
OPENROUTER_API_KEY=

# Mistral (free tier - https://console.mistral.ai)
MISTRAL_API_KEY=

# Supabase (free tier)
# Project Settings → API Keys. The publishable key (sb_publishable_…) is safe in
# the browser; the secret key (sb_secret_…) is server-only and bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# LangFuse (free tier - agent observability)
# Note: previously named LANGFUSE_HOST — update any existing .env / CI secrets accordingly
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# development locally; set to preview / production on Vercel so test traffic
# stays out of production dashboards.
LANGFUSE_TRACING_ENVIRONMENT=development

# PostHog (free tier - analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Turnstile (bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Demo account (optional — powers the "Explore the demo" button; seeding lands in Phase 7)
# Email that owns the seeded sample data. The account is passwordless; the demo
# button mints a one-time magic-link token server-side.
DEMO_USER_EMAIL=
# Set to 1 to show the "Explore the demo" button on the sign-in screen.
NEXT_PUBLIC_DEMO_ENABLED=


# Food data (Phase 1)
# Identifies us to Open Food Facts: a project contact email or URL.
OFF_CONTACT=
# Free key from https://api.data.gov/signup (1,000 req/hour). Without it,
# USDA generic-food lookups are skipped.
USDA_API_KEY=

# Billing: Stripe (Pro plan). Without these the app runs, and checkout answers
# "Billing is not set up yet". See README → Billing.
STRIPE_SECRET_KEY=          # sk_test_… locally, sk_live_… in production
STRIPE_WEBHOOK_SECRET=      # whsec_… for the endpoint /api/billing/webhook
STRIPE_PRICE_MONTHLY=       # price_… (€5.99 a month)
STRIPE_PRICE_YEARLY=        # price_… (€39.99 a year)
STRIPE_AUTOMATIC_TAX=       # 1 once Stripe Tax is set up
STRIPE_REQUIRE_TERMS=       # 1 once a Terms of Service URL is set in Stripe (Settings → Public details)

# Shared secret for /api/cron/nudges (sent as "Authorization: Bearer …")
CRON_SECRET=
