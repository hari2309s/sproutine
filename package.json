{
  "name": "sproutine",
  "version": "1.0.0",
  "description": "Eat well, one sprout at a time. A voice-first healthy eating companion that logs your meals, plans your week and nudges you gently, without the guilt.",
  "author": "Hariharan Selvaraj <hariharan.2309.s@icloud.com> (https://github.com/hari2309s)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "test": "vitest run --exclude 'apps/web/e2e/**'",
    "seed:demo": "npx tsx scripts/seed-demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langfuse/client": "^5.13.1",
    "@langfuse/otel": "^5.13.1",
    "@langfuse/tracing": "^5.13.1",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@supabase/supabase-js": "^2.117.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2"
}
