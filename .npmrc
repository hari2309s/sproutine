# langfuse/experiment-action (.github/workflows/langfuse-eval.yml) generates a
# bootstrap entry file at the repo root that bare-imports @langfuse/* and
# @opentelemetry/* packages directly, including ones that are only transitive
# dependencies here (e.g. @langfuse/core, pulled in by @langfuse/client et al.
# but never declared anywhere). pnpm's default strict/isolated node_modules
# doesn't expose those at root the way a flat npm install would — hoist the
# whole families so the entry file resolves cleanly instead of failing on a
# new transitive package every time one of these SDKs' dependency trees shifts.
public-hoist-pattern[]=@langfuse/*
public-hoist-pattern[]=@opentelemetry/*
